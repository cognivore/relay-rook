{
  "manifest_version": 3,
  "name": "Relay Rook (Chessable Sync)",
  "version": "0.6.0",
  "description": "Sync the Chessable board to a Chessnut Move board.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.chess.localhost/*",
    "*://*.chessable.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chessable.com/*"
      ],
      "js": [
        "src/boardParser.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
