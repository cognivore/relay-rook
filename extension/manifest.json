{
  "manifest_version": 3,
  "name": "Relay Rook (Chessable Sync)",
  "version": "0.4.3",
  "description": "Sync Chessable to a Chessnut board and archive course books as PGN and private Lichess studies.",
  "permissions": ["storage", "scripting", "downloads"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.chess.localhost/*",
    "*://*.chessable.com/*",
    "https://lichess.org/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.chessable.com/*"],
      "js": ["archive/book.js", "src/archive-scan.js", "src/boardParser.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
